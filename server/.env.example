# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=

# JWT Secret - Use a strong random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Gemini API Key
# Get one at https://ai.google.dev/
# IMPORTANT: Do not hardcode or commit your real key. Add it only to server/.env.local.
GEMINI_API_KEY=your-gemini-api-key-here

# NVIDIA API Key (for Llama models and advanced financial extraction)
# Get one at https://build.nvidia.com/
# IMPORTANT: Do not hardcode or commit your real key. Add it only to server/.env.local.
NVIDIA_API_KEY=your-nvidia-api-key-here

# AI Model Provider (gemini or nvidia)
# Use 'nvidia' for Llama 3.1 70B (better for financial documents)
# Use 'gemini' for Google's models (lighter weight)
AI_PROVIDER=nvidia

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

